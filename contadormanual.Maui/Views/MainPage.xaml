<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="contadormanual.Maui.Views.MainPage"
             Title="Contador Manual">


    <StackLayout
        Orientation="Vertical"
        Spacing="12"
        Margin="12, 24,36,48"
        Padding="12,19,0,36">
        <Label Text="Conteo"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               FontSize="Medium"/>

        <Border
            StrokeThickness="2">
            <Label Text="10"
              HorizontalOptions="Center"
              VerticalOptions="Center"
                   
                   Padding="0,24"
                   FontSize="Large"
                   FontAttributes="Bold"
                  x:Name="ConteoLabel" />

        </Border>

        <StackLayout 
            Orientation="Horizontal"
            HorizontalOptions="Center"
            Spacing="12"
            Margin="0,24,0,0">

            <Button Text="Contar"
                    FontSize="Medium"
                  Clicked="Contar_Clicked"/>
           
            <Button Text="Reiniciar"
                    FontSize="Medium"
                    Clicked="Reiniciar_Clicked"/>
        </StackLayout>
    </StackLayout>
</ContentPage>